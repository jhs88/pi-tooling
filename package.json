{
  "name": "@jhs88/pi-tooling",
  "version": "0.1.2",
  "private": true,
  "description": "Selected file search, Firecrawl, ask-user, background terminal, workflow, and authenticated A2A tools for Pi",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhs88/pi-tooling.git"
  },
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-a2a-server": "./a2a/cli.mjs",
    "pi-subagents-compat": "./scripts/patch-pi-subagents.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types a2a/*.test.ts ask-user/*.test.ts background-terminals/*.test.ts compat/*.test.mjs file-search/*.test.ts firecrawl/*.test.ts integration/*.test.ts shared/*.test.ts workflows/*.test.ts",
    "compat:subagents": "node scripts/patch-pi-subagents.mjs",
    "test:compat": "node --test compat/*.test.mjs",
    "verify": "npm run check && npm test",
    "verify:production": "node scripts/verify-production-install.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.98",
    "@effect/platform-node-shared": "4.0.0-beta.98",
    "acorn": "8.17.0",
    "effect": "4.0.0-beta.98",
    "firecrawl": "4.42.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@effect/tsgo": "0.19.0",
    "@tintinweb/pi-subagents": "0.19.0",
    "@types/node": "26.1.1",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  }
}
