{
  "name": "@jhs88/pi-tooling",
  "version": "0.1.1",
  "private": true,
  "description": "Selected file search, Firecrawl, ask-user, background terminal, and workflow tools for Pi",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhs88/pi-tooling.git"
  },
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types ask-user/*.test.ts background-terminals/*.test.ts file-search/*.test.ts firecrawl/*.test.ts integration/*.test.ts shared/*.test.ts workflows/*.test.ts",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.98",
    "@effect/platform-node-shared": "4.0.0-beta.98",
    "acorn": "8.17.0",
    "effect": "4.0.0-beta.98",
    "firecrawl": "4.30.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@effect/tsgo": "0.19.0",
    "@types/node": "26.1.1",
    "typebox": "1.3.6",
    "typescript": "7.0.2"
  }
}
